<html lang='ar' dir='rtl'>
    <head>
        <meta charset='UTF-8' />
        <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    </head>

    <body
        style='margin:0;padding:0;background:#0b0b12;font-family:Cairo,Arial,sans-serif;direction:rtl;'
    >

        <table
            width='100%'
            cellpadding='0'
            cellspacing='0'
            style='background:#0b0b12;padding:20px 8px;'
        >
            <tr>
                <td align='center'>

                    <table
                        width='520'
                        cellpadding='0'
                        cellspacing='0'
                        style='max-width:520px;background:#0b0b12;color:#ffffff;border-radius:20px;overflow:hidden;'
                    >

                        <tr>
                            <td
                                style='height:4px;background:linear-gradient(90deg,#7c4dff,#00d4aa);'
                            ></td>
                        </tr>

                        <tr>
                            <td style='padding:30px 24px;text-align:right;'>

                                <img
                                    src='https://api.vocalaid.app/public/logo.png'
                                    width='42'
                                    style='display:block;margin-bottom:14px;'
                                />

                                <div
                                    style='font-size:26px;font-weight:800;color:#b39cff;margin-bottom:6px;'
                                >
                                    وصلة
                                </div>

                                <div
                                    style='font-size:14px;color:#9ca3af;margin-bottom:28px;'
                                >
                                    جسر لغة الإشارة
                                </div>

                                <div
                                    style='font-size:13px;color:#00d4aa;font-weight:700;margin-bottom:10px;'
                                >
                                    تأكيد البريد الإلكتروني
                                </div>

                                <div
                                    style='font-size:26px;font-weight:800;margin-bottom:14px;'
                                >
                                    تأكيد هويتك
                                </div>

                                <div
                                    style='font-size:15px;color:#cbd5e1;line-height:1.9;margin-bottom:30px;'
                                >
                                    مرحباً
                                    <span dir='ltr'><b>{{name}}</b></span>،
                                    استخدم رمز التحقق أدناه لإكمال العملية.
                                </div>

                            </td>
                        </tr>

                        <tr>
                            <td align='center' style='padding-bottom:20px;'>

                                <table
                                    cellpadding='0'
                                    cellspacing='0'
                                    dir='ltr'
                                >
                                    <tr>

                                        <td
                                            style='width:52px;height:62px;border:2px solid #8b5cf6;border-radius:14px;text-align:center;font-size:28px;font-weight:800;color:#a78bfa;'
                                        >{{d1}}</td>
                                        <td width='8'></td>

                                        <td
                                            style='width:52px;height:62px;border:2px solid #8b5cf6;border-radius:14px;text-align:center;font-size:28px;font-weight:800;color:#a78bfa;'
                                        >{{d2}}</td>
                                        <td width='8'></td>

                                        <td
                                            style='width:52px;height:62px;border:2px solid #8b5cf6;border-radius:14px;text-align:center;font-size:28px;font-weight:800;color:#a78bfa;'
                                        >{{d3}}</td>
                                        <td width='8'></td>

                                        <td
                                            style='width:52px;height:62px;border:2px solid #8b5cf6;border-radius:14px;text-align:center;font-size:28px;font-weight:800;color:#a78bfa;'
                                        >{{d4}}</td>
                                        <td width='8'></td>

                                        <td
                                            style='width:52px;height:62px;border:2px solid #8b5cf6;border-radius:14px;text-align:center;font-size:28px;font-weight:800;color:#a78bfa;'
                                        >{{d5}}</td>
                                        <td width='8'></td>

                                        <td
                                            style='width:52px;height:62px;border:2px solid #8b5cf6;border-radius:14px;text-align:center;font-size:28px;font-weight:800;color:#a78bfa;'
                                        >{{d6}}</td>

                                    </tr>
                                </table>

                            </td>
                        </tr>

                        <tr>
                            <td align='center' style='padding-bottom:30px;'>

                                <div
                                    style='display:inline-block;background:#062f2a;border:1px solid #00d4aa;border-radius:40px;padding:10px 22px;font-size:14px;color:#00d4aa;'
                                >
                                    ينتهي خلال
                                    {{minutes}}
                                    دقيقة
                                </div>

                            </td>
                        </tr>

                        <tr>
                            <td style='padding:0 24px 30px 24px;'>

                                <div
                                    style='background:#1a1215;border-right:4px solid #ff3b82;padding:16px;border-radius:10px;font-size:13px;color:#cbd5e1;line-height:1.8;text-align:right;'
                                >
                                    <strong style='color:#ff3b82;'>تنبيه أمني:</strong>
                                    إذا لم تطلب هذا الرمز يمكنك تجاهل هذه
                                    الرسالة بأمان.
                                </div>

                            </td>
                        </tr>

                    </table>

                </td>
            </tr>
        </table>

    </body>
</html>