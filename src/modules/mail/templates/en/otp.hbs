<html lang='en'>
    <head>
        <meta charset='UTF-8' />
        <meta name='viewport' content='width=device-width, initial-scale=1.0' />
        <title>Wasla OTP</title>
    </head>

    <body
        style='margin:0;padding:0;background:#eeedf9;font-family:Cairo,Arial,sans-serif;'
    >

        <table
            width='100%'
            cellpadding='0'
            cellspacing='0'
            border='0'
            style='background:#eeedf9;padding:30px 10px;'
        >
            <tr>
                <td align='center'>

                    <table
                        width='520'
                        cellpadding='0'
                        cellspacing='0'
                        border='0'
                        style='max-width:520px;background:#ffffff;border-radius:20px;overflow:hidden;box-shadow:0 8px 40px rgba(0,0,0,0.08);'
                    >

                        <tr>
                            <td
                                style='height:4px;background:linear-gradient(90deg,#ed4181,#5140e8,#15aa96);'
                            ></td>
                        </tr>

                        <tr>
                            <td
                                align='center'
                                style='padding:30px 20px 10px 20px;'
                            >

                                <img
                                    src='https://api.vocalaid.app/public/logo.png'
                                    width='48'
                                    style='display:block;margin-bottom:10px;'
                                />

                                <div
                                    style='font-size:22px;font-weight:800;color:#5140e8;'
                                >
                                    Wasla
                                </div>

                                <div style='font-size:12px;color:#777;'>
                                    Sign Language Bridge
                                </div>

                            </td>
                        </tr>

                        <tr>
                            <td style='padding:20px 30px 10px 30px;'>

                                <div
                                    style='font-size:12px;font-weight:700;color:#15aa96;margin-bottom:10px;'
                                >
                                    EMAIL VERIFICATION
                                </div>

                                <div
                                    style='font-size:22px;font-weight:700;color:#1f2937;margin-bottom:10px;'
                                >
                                    Confirm your identity
                                </div>

                                <div
                                    style='font-size:14px;color:#63677e;line-height:1.6;'
                                >
                                    Hey
                                    <b>{{name}}</b>, use the verification code
                                    below to continue. Keep this code private.
                                </div>

                            </td>
                        </tr>

                        <tr>
                            <td align='center' style='padding:20px;'>

                                <table cellpadding='0' cellspacing='0'>
                                    <tr>

                                        <td
                                            style='width:48px;height:58px;border:2px solid #5140e8;border-radius:12px;text-align:center;font-size:26px;font-weight:800;color:#5140e8;'
                                        >{{d1}}</td>
                                        <td width='6'></td>
                                        <td
                                            style='width:48px;height:58px;border:2px solid #5140e8;border-radius:12px;text-align:center;font-size:26px;font-weight:800;color:#5140e8;'
                                        >{{d2}}</td>
                                        <td width='6'></td>
                                        <td
                                            style='width:48px;height:58px;border:2px solid #5140e8;border-radius:12px;text-align:center;font-size:26px;font-weight:800;color:#5140e8;'
                                        >{{d3}}</td>
                                        <td width='6'></td>
                                        <td
                                            style='width:48px;height:58px;border:2px solid #5140e8;border-radius:12px;text-align:center;font-size:26px;font-weight:800;color:#5140e8;'
                                        >{{d4}}</td>
                                        <td width='6'></td>
                                        <td
                                            style='width:48px;height:58px;border:2px solid #5140e8;border-radius:12px;text-align:center;font-size:26px;font-weight:800;color:#5140e8;'
                                        >{{d5}}</td>
                                        <td width='6'></td>
                                        <td
                                            style='width:48px;height:58px;border:2px solid #5140e8;border-radius:12px;text-align:center;font-size:26px;font-weight:800;color:#5140e8;'
                                        >{{d6}}</td>

                                    </tr>
                                </table>

                            </td>
                        </tr>

                        <tr>
                            <td align='center'>

                                <div
                                    style='display:inline-block;background:#e8faf7;border:1px solid #15aa96;border-radius:30px;padding:8px 18px;font-size:13px;color:#15aa96;font-weight:600;'
                                >
                                    Expires in
                                    {{minutes}}
                                    minutes
                                </div>

                            </td>
                        </tr>

                        <tr>
                            <td style='padding:30px'>

                                <div
                                    style='background:#fff5f8;border-left:4px solid #ed4181;padding:15px;border-radius:8px;font-size:13px;color:#666;'
                                >
                                    <strong style='color:#ed4181'>Security
                                        notice:</strong>
                                    If you didn't request this code, ignore this
                                    email.
                                </div>

                            </td>
                        </tr>

                        <tr>
                            <td
                                align='center'
                                style='padding:20px;background:#f8f8fc;font-size:12px;color:#777;'
                            >
                                © 2026 Wasla — All rights reserved
                            </td>
                        </tr>

                    </table>

                </td>
            </tr>
        </table>

    </body>
</html>